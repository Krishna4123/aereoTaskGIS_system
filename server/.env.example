# Application
APP_NAME="GeoMeasure AI API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="geomeasure_ai"

# Storage
STORAGE_UPLOAD_DIR="./storage/uploads"
STORAGE_PROCESSED_DIR="./storage/processed"
MAX_UPLOAD_SIZE_MB=150

# LLM / AI Analyst
LLM_PROVIDER="openai"
LLM_MODEL_NAME="gpt-4o"
LLM_API_KEY="your-api-key-here-placeholder"
